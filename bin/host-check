#!/usr/bin/env python3
"""Queue a validation command so agents on this machine share the CPU.

One job per physical Git worktree, and host-wide caps on all jobs, heavy jobs
(whole suites and builds), and builds, from ~/.config/fleet/host.json. On
Linux the job runs in a systemd user slice whose CPU and memory limits the
kernel enforces; on macOS it runs under a taskpolicy QoS clamp, so it yields
the CPU to interactive work. Lock files live in ~/.cache/host-check and are
held by the command and every child that inherits them.
"""
import fcntl
import hashlib
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys
import time

LIB = Path(os.path.realpath(__file__)).parent.parent / "lib" / "host-check"
sys.path.insert(0, str(LIB))
import hostconf  # noqa: E402

CLASSES = ("build", "heavy", "light")


def say(message):
    print(f"host-check: {message}", file=sys.stderr, flush=True)


def usage(conf):
    print("Usage: host-check COMMAND [ARG ...]")
    builds = "build" if conf["build_slots"] == 1 else "builds"
    print(f"One job per worktree; up to {conf['slots']} jobs, {conf['heavy_slots']} heavy "
          f"(whole suites and builds), {conf['build_slots']} {builds}.")
    print(f"Vitest defaults to {conf['vitest_max_workers']} workers. "
          "HOST_CHECK_CLASS=build|heavy|light overrides the detected class.")
    print("Run from the target worktree. Wrap a command or pipeline, never both.")
    print(f"Policy: {hostconf.HOST_VALIDATION}")


def open_lock(path):
    return os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)


def wait_for(fd, mode, describe, started):
    """Block until the lock is held, reporting every ten seconds."""
    next_report = time.monotonic() + 10
    while True:
        try:
            fcntl.flock(fd, mode | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            pass
        if time.monotonic() >= next_report:
            say(f"waiting for {describe()} ({int(time.monotonic() - started)}s)")
            next_report += 10
        time.sleep(0.2)


def worktree_root():
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        top = os.getcwd()
    return os.path.realpath(top or os.getcwd())


def classify(argv):
    chosen = os.environ.get("HOST_CHECK_CLASS")
    if chosen not in CLASSES:
        try:
            import guard
            chosen = guard.job_class(shlex.join(argv))
        except Exception:  # an unreadable command is treated as heavy
            chosen = "heavy"
    return chosen if chosen in CLASSES else "heavy"


def launcher(conf):
    """The command prefix that applies this machine's CPU policy."""
    nice = ["nice", "-n", str(conf["nice"])] if conf["nice"] else []
    if platform.system() == "Darwin":
        if conf["qos_clamp"] and shutil.which("taskpolicy"):
            return ["taskpolicy", "-c", conf["qos_clamp"], *nice], f"QoS clamp {conf['qos_clamp']}"
        return nice, "without a QoS clamp"
    if conf["slice"]:
        bus = subprocess.run(["systemctl", "--user", "show-environment"],
                             capture_output=True).returncode == 0 if shutil.which("systemctl") else False
        if bus:
            # systemd 259 expands $VAR in the command unless told not to.
            return (["systemd-run", "--user", "--scope", "--quiet", "--collect", "--expand-environment=no",
                     f"--slice={conf['slice']}", *nice], conf["slice"])
        say(f"no user systemd bus; running outside {conf['slice']}")
    return ["nice", "-n", str(max(conf["nice"], 10))], "nice"


def main(argv):
    conf = hostconf.load()
    if not argv or argv[0] in ("--help", "-h"):
        usage(conf)
        return 0
    if os.environ.get("HOST_CHECK_ACTIVE") == "1":
        say("nested invocation refused; wrap the pipeline only once.")
        return 64

    queue = Path(os.environ.get("HOST_CHECK_QUEUE_DIR") or Path.home() / ".cache" / "host-check")
    (queue / "worktrees").mkdir(parents=True, exist_ok=True)
    os.chmod(queue, 0o700)
    os.chmod(queue / "worktrees", 0o700)
    started = time.monotonic()
    held = []

    # Jobs from the previous wrapper generation hold this lock exclusively.
    # Shared holders run together but never overlap one of those.
    legacy = open_lock(queue / "lock")
    wait_for(legacy, fcntl.LOCK_SH, lambda: "legacy validation to finish", started)
    held.append(legacy)

    worktree = worktree_root()
    key = hashlib.sha256(worktree.encode()).hexdigest()
    # Taken before any global slot, so same-worktree waiters consume no slots.
    tree = open_lock(queue / "worktrees" / f"{key}.lock")
    wait_for(tree, fcntl.LOCK_EX, lambda: f"worktree {shlex.quote(worktree)}", started)
    held.append(tree)

    job_class = classify(argv)

    def acquire(prefix, count, label):
        """Hold the first free of COUNT slots; classes go build, heavy, global, so no deadlock."""
        next_report = time.monotonic() + 10
        while True:
            for number in range(1, count + 1):
                fd = open_lock(queue / f"{prefix}-{number}.lock")
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    os.close(fd)
                    continue
                stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
                (queue / f"{prefix}-{number}.owner").write_text(
                    f"pid={os.getpid()} class={job_class} executable={shlex.quote(argv[0])} "
                    f"worktree={shlex.quote(worktree)} started={stamp}\n")
                held.append(fd)
                return number
            if time.monotonic() >= next_report:
                say(f"waiting for {label} ({int(time.monotonic() - started)}s)")
                next_report += 10
            time.sleep(1)

    classes = []
    if job_class == "build":
        n = acquire("build", conf["build_slots"], f"a build slot ({conf['build_slots']} builds at once)")
        classes.append(f"build {n}/{conf['build_slots']}")
    if job_class != "light":
        n = acquire("heavy", conf["heavy_slots"],
                    f"a heavy slot ({conf['heavy_slots']} whole suites or builds at once)")
        classes.append(f"heavy {n}/{conf['heavy_slots']}")
    slot = acquire("slot", conf["slots"], "a global slot")

    prefix, where = launcher(conf)
    detail = f", {', '.join(classes)}" if classes else ""
    say(f"acquired slot {slot} ({job_class}{detail}) after {int(time.monotonic() - started)}s; "
        f"running {shlex.quote(argv[0])} ({where})")

    env = dict(os.environ, HOST_CHECK_ACTIVE="1")
    env.setdefault("VITEST_MAX_WORKERS", str(conf["vitest_max_workers"]))
    # The command and its surviving children keep the locks until they exit.
    for fd in held:
        os.set_inheritable(fd, True)
    command = [*prefix, *argv]
    try:
        os.execvpe(command[0], command, env)
    except FileNotFoundError:
        say(f"command not found: {command[0]}")
        return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
